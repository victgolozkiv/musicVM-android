<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_black"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/bgGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_bg_gradient" />

    <ImageButton
        android:id="@+id/btnDismiss"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_white" />

    <TextView
        android:id="@+id/tvPlayingNowLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/playing_now"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        app:layout_constraintBottom_toBottomOf="@id/btnDismiss"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnDismiss" />

    <ImageButton
        android:id="@+id/btnCast"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_cast_premium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnDismiss"
        app:tint="@color/text_white" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDisc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="60dp"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="250dp"
        app:cardElevation="30dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnDismiss"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/imgFullPlayerArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:transitionName="cover_transition"
            tools:src="@android:drawable/ic_menu_report_image" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvFullPlayerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="40dp"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textColor="@color/text_white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardDisc"
        tools:text="Song Title" />

    <TextView
        android:id="@+id/tvFullPlayerArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/purple_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="@id/tvFullPlayerTitle"
        app:layout_constraintStart_toStartOf="@id/tvFullPlayerTitle"
        app:layout_constraintTop_toBottomOf="@id/tvFullPlayerTitle"
        tools:text="Artist Name" />

    <TextView
        android:id="@+id/tvCurrentLyric"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFullPlayerArtist"
        app:layout_constraintBottom_toTopOf="@id/playerSlider"
        tools:text="♪ Singing lyrics here ♪" />

    <com.google.android.material.slider.Slider
        android:id="@+id/playerSlider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFullPlayerArtist"
        app:thumbColor="@color/purple_primary"
        app:thumbRadius="6dp"
        app:thumbElevation="4dp"
        app:trackColorActive="@color/purple_primary"
        app:trackColorInactive="#26FFFFFF"
        app:haloColor="#4D6200EE" />

    <TextView
        android:id="@+id/tvCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/time_zero"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/playerSlider"
        app:layout_constraintTop_toBottomOf="@id/playerSlider" />

    <TextView
        android:id="@+id/tvTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="@string/time_zero"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/playerSlider"
        app:layout_constraintTop_toBottomOf="@id/playerSlider" />

    <LinearLayout
        android:id="@+id/llControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentTime">

        <ImageButton
            android:id="@+id/btnQueue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_playlist"
            app:tint="@color/text_white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabCustomSize="56dp"
            app:backgroundTint="#1AFFFFFF"
            app:tint="@color/text_white"
            app:elevation="0dp"
            app:hoveredFocusedTranslationZ="0dp"
            app:pressedTranslationZ="4dp"
            app:borderWidth="0dp"
            app:rippleColor="#4DFFFFFF"
            app:srcCompat="@drawable/ic_prev_mod" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnFullPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="28dp"
            app:backgroundTint="@color/purple_primary"
            app:fabCustomSize="80dp"
            app:maxImageSize="40dp"
            app:elevation="12dp"
            app:hoveredFocusedTranslationZ="16dp"
            app:pressedTranslationZ="20dp"
            app:srcCompat="@drawable/ic_play_mod"
            app:tint="@color/text_white"
            app:borderWidth="0dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fabCustomSize="56dp"
            app:backgroundTint="#1AFFFFFF"
            app:tint="@color/text_white"
            app:elevation="0dp"
            app:hoveredFocusedTranslationZ="0dp"
            app:pressedTranslationZ="4dp"
            app:borderWidth="0dp"
            app:rippleColor="#4DFFFFFF"
            app:srcCompat="@drawable/ic_next_mod" />
            
        <ImageButton
            android:id="@+id/btnEqualizer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_equalizer"
            app:tint="@color/text_white" />
    </LinearLayout>

    <com.musicplayer.ui.view.VisualizerView
        android:id="@+id/visualizerView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FULL LYRICS OVERLAY -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llFullLyrics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pure_black"
        android:visibility="gone"
        android:elevation="100dp"
        android:clickable="true"
        android:focusable="true">

        <ImageButton
            android:id="@+id/btnCloseLyrics"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lyrics_label"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/btnCloseLyrics"
            app:layout_constraintBottom_toBottomOf="@id/btnCloseLyrics"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLyrics"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:paddingBottom="100dp"
            app:layout_constraintTop_toBottomOf="@id/btnCloseLyrics"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
