<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_black"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvPlaylistsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/my_playlists"
        android:textColor="@color/text_white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- PLAYLIST SEARCH DISCOVERY -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilOnlineSearch"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Buscar Mixes de Artistas Online"
        android:textColorHint="@color/text_grey"
        app:boxStrokeColor="@color/purple_primary"
        app:hintTextColor="@color/purple_primary"
        app:layout_constraintTop_toBottomOf="@id/tvPlaylistsHeader"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="@color/purple_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etOnlineSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="@color/text_white" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- LOCAL PLAYLISTS TITLE -->
    <TextView
        android:id="@+id/tvLocalHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Mis Playlists Locales"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilOnlineSearch" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreatePlaylist"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_playlist"
        android:textColor="@color/purple_primary"
        app:layout_constraintBottom_toBottomOf="@id/tvLocalHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvLocalHeader" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlaylists"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLocalHeader"
        tools:listitem="@android:layout/simple_list_item_1" />

</androidx.constraintlayout.widget.ConstraintLayout>
